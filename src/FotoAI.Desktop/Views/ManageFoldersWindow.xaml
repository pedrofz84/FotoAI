<Window x:Class="FotoAI.Desktop.Views.ManageFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerir Bibliotecas (Pastas)" Height="450" Width="680"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pastas Indexadas pela IA" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" Text="As fotos nestas pastas estão traduzidas para o Motor de Pesquisa Semântica." Foreground="#AAAAAA" Margin="0,0,0,15"/>

        <ProgressBar Grid.Row="1" VerticalAlignment="Bottom" Height="2" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <ListView Grid.Row="2" ItemsSource="{Binding Folders}" Background="Transparent" BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2D2D30" CornerRadius="8" Padding="15" Margin="5,5,5,10" Width="610">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding TypeLabel}" Foreground="#31A8FF" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding FolderPath}" FontWeight="Bold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding ImageCount, StringFormat=\{0\} Imagens Salvas}" Foreground="#007ACC" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding ScanStatus, StringFormat=Estado: \{0\}}" Foreground="#888888" FontSize="11" Margin="0,1,10,0"/>
                                    <TextBlock Text="{Binding LastScanned, StringFormat=Último Scan: \{0\}}" Foreground="#555555" FontSize="11" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Binding à lista superior para invocar os comandos e passar o item atual (o Folder) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Sincronizar" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand" Margin="0,0,8,0"
                                        ToolTip="Procura fotos novas, editadas ou removidas"
                                        Command="{Binding DataContext.SyncFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}"/>
                                <Button Content="Apagar Memória" Background="#CC3333" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand" 
                                        Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Window>
