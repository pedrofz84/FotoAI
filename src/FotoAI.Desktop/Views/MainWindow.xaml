<Window x:Class="FotoAI.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FotoAI.Desktop.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="FotoAI" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="Transparent" Foreground="White" Margin="-10,-10,-10,10">
            <MenuItem Header="Ficheiro">
                <MenuItem Header="Indexar Pasta..." Command="{Binding IndexFolderCommand}"/>
                <MenuItem Header="Importar catálogo Lightroom..." Command="{Binding ImportLightroomCommand}"/>
                <MenuItem Header="Gerir Pastas..." Command="{Binding ManageFoldersCommand}"/>
                <Separator />
                <MenuItem Header="Sair" Click="MenuItemExit_Click"/>
            </MenuItem>
            <MenuItem Header="Ajuda">
                <MenuItem Header="Sobre o FotoAI..." Command="{Binding ShowAboutCommand}"/>
                <MenuItem Header="FAQ / Ajuda..." Command="{Binding ShowAboutCommand}"/> <!-- FAQ is inside About for now -->
            </MenuItem>
        </Menu>

        <!-- Header -->
        <TextBlock Grid.Row="1" Text="FotoAI" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Search Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalContentAlignment="Center"
                     Padding="5" FontSize="14" Height="35">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            
            <Button Grid.Column="1" Content="Pesquisar" Command="{Binding SearchCommand}" 
                    Margin="10,0,0,0" Width="100" Height="35" Cursor="Hand"/>

            <Button Grid.Column="2" Content="📷" Command="{Binding SearchByImageFileCommand}" 
                    Margin="10,0,0,0" Width="40" Height="35" Cursor="Hand" ToolTip="Pesquisar por imagem externa"/>
                    
            <Button Grid.Column="3" Content="Indexar Pasta..." Command="{Binding IndexFolderCommand}" 
                    Margin="10,0,0,0" Width="130" Height="35" Cursor="Hand" 
                    Background="#007ACC" Foreground="White" BorderThickness="0"/>
                    
            <Button Grid.Column="4" Content="Lightroom..." Command="{Binding ImportLightroomCommand}" 
                    Margin="10,0,0,0" Width="100" Height="35" Cursor="Hand" ToolTip="Importar um catálogo do Lightroom Classic (.lrcat)"
                    Background="#31A8FF" Foreground="White" BorderThickness="0"/>

            <Button Grid.Column="5" Content="Gerir Pastas 🗑️" Command="{Binding ManageFoldersCommand}" 
                    Margin="10,0,0,0" Width="130" Height="35" Cursor="Hand" 
                    Background="#444444" Foreground="White" BorderThickness="0"/>
        </Grid>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="2" VerticalAlignment="Bottom" Height="3" Margin="0,0,110,0"
                     IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Filtro por ano de captura -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="Ano: de" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding YearFrom}" Width="80"/>
            <TextBlock Text="até" VerticalAlignment="Center" Margin="8,0,6,0"/>
            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding YearTo}" Width="80"/>
            <TextBlock Text="Ordenar:" VerticalAlignment="Center" Margin="24,0,6,0"/>
            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortOrder}" Width="120"/>
            <TextBlock Text="{Binding YearFilterHint}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="#888888" FontSize="11"/>
        </StackPanel>

        <!-- Results Grid -->
        <ListView x:Name="ResultsList" Grid.Row="4" ItemsSource="{Binding SearchResults}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- O Tag carrega o ViewModel principal para dentro do ContextMenu que vive numa PopUp Tree isolada -->
                    <Border Tag="{Binding DataContext, ElementName=ResultsList}" Background="#2D2D30" CornerRadius="8" Margin="5" Width="200" Height="220" Padding="10">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Abrir Imagem Original" 
                                          Command="{Binding PlacementTarget.Tag.OpenImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                          CommandParameter="{Binding PlacementTarget.DataContext.FilePath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Abrir Local da Ficheiro..." 
                                          Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                          CommandParameter="{Binding PlacementTarget.DataContext.FilePath, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator />
                                <MenuItem Header="🔍 Procurar Imagens Semelhantes" 
                                          Command="{Binding PlacementTarget.Tag.SearchSimilarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                          CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <!-- Binding à Thumbnail (CacheOption assegura que o WPF não congela a UI ao ir buscar à RAM do URL de loopback) -->
                            <Image Source="{Binding ThumbnailUrl}" Height="150" Stretch="UniformToFill" Margin="0,0,0,10" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" Foreground="White"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Score, StringFormat=Relevância: {0:F3}}" Foreground="#007ACC" FontSize="11"/>
                                <TextBlock Text="{Binding CaptureDateText}" Foreground="#888888" FontSize="11" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer StatusBar: o motor diz sempre o que está a fazer -->
        <!-- Paginação -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="{Binding ResultsCountText}" VerticalAlignment="Center" Foreground="#888888" Margin="0,0,12,0"/>
            <Button Content="Mostrar mais" Command="{Binding LoadMoreCommand}" Padding="16,6" Cursor="Hand"
                    Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0" Width="160" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                         Minimum="0" Maximum="100" Value="{Binding StatusProgress}"
                         IsIndeterminate="{Binding IsStatusProgressIndeterminate}"
                         Visibility="{Binding IsStatusProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Grid.Column="1" Text="{Binding EngineStatusText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding EngineStatusText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#AAAAAA"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="#F48771"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="2" Text="Criado por Pedro Silva · pedro-silva.com" Margin="10,0,0,0"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="#444444" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
